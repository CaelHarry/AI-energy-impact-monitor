# =============================================================
#  AI Energy Impact Monitor — .gitignore
# =============================================================

# ── Secrets (NEVER commit these) ─────────────────────────────
.env
*.key
*.pem
*.p12
*.pfx
secrets/

# ── Docker volumes (large, machine-specific) ──────────────────
postgres-data/
pgadmin-data/

# ── Airflow ───────────────────────────────────────────────────
airflow/logs/
airflow/plugins/__pycache__/
airflow/dags/__pycache__/
airflow/dags/*.pyc

# ── dbt ───────────────────────────────────────────────────────
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.dbt/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/
.env.local
.env.*.local

# ── Jupyter (if used for exploration) ────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Data files (keep schema, not raw data) ────────────────────
*.csv
*.parquet
*.json.gz
data/raw/
data/processed/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/

# ── Testing / coverage ────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
