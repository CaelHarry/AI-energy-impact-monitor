      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "pipeline-db" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
