            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Temperature (°C)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "custom.axisPlacement", "value": "left" },
              { "id": "custom.axisLabel", "value": "°C" },
              { "id": "unit", "value": "celsius" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Demand (GW)" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.axisLabel", "value": "GW" },
              { "id": "unit", "value": "short" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "pipeline-db" },
          "format": "time_series",
          "rawSql": "SELECT time, temperature_2m AS \"Temperature (°C)\" FROM weather_raw WHERE region_id = 'ERCOT' AND $__timeFilter(time) AND temperature_2m IS NOT NULL ORDER BY time",
          "refId": "A"
        },
        {
          "datasource": { "type": "postgres", "uid": "pipeline-db" },
          "format": "time_series",
          "rawSql": "SELECT bucket AS \"time\", ROUND((demand_avg_mw / 1000)::numeric, 1) AS \"Demand (GW)\" FROM grid_demand_hourly WHERE region_id = 'ERCOT' AND $__timeFilter(bucket) ORDER BY bucket",
          "refId": "B"
        }
      ],
      "title": "ERCOT — Temperature vs Demand",
      "type": "timeseries"
    },
