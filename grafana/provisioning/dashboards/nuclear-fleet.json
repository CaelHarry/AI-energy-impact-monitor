          "datasource": { "type": "postgres", "uid": "pipeline-db" },
          "format": "table",
          "rawSql": "SELECT * FROM (SELECT DISTINCT ON (unit_name) unit_name AS \"Reactor\", region_id AS \"Grid Region\", ROUND(power_pct::numeric, 0) AS \"Capacity %\", COALESCE(operator, 'Unknown') AS \"Operator\", time::date AS \"Report Date\" FROM nuclear_status_raw WHERE region_id IS NOT NULL AND power_pct IS NOT NULL ORDER BY unit_name, time DESC) latest ORDER BY \"Grid Region\", \"Capacity %\" DESC",
          "refId": "A"
        }
      ],
