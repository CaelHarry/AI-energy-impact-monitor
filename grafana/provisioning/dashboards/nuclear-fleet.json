      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "pipeline-db" },
          "format": "time_series",
          "rawSql": "SELECT time, ROUND(AVG(CASE WHEN region_id = 'ERCOT' THEN power_pct END)::numeric, 1) AS \"ERCOT\", ROUND(AVG(CASE WHEN region_id = 'CAISO' THEN power_pct END)::numeric, 1) AS \"CAISO\", ROUND(AVG(CASE WHEN region_id = 'PJM' THEN power_pct END)::numeric, 1) AS \"PJM\" FROM nuclear_status_raw WHERE $__timeFilter(time) AND power_pct IS NOT NULL GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Fleet-Average Capacity by Region (% of licensed capacity)",
      "type": "timeseries"
    }
