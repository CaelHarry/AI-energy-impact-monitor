          "rawSql": "SELECT spike_hour AS \"Spike Hour\", region_id AS \"Region\", ROUND(demand_anomaly_mw::numeric, 0) AS \"Anomaly (MW)\", ROUND(demand_avg_mw::numeric, 0) AS \"Avg Demand (MW)\", ROUND(temperature_c::numeric, 1) AS \"Temp (°C)\", ROUND(apparent_temperature_c::numeric, 1) AS \"Feels Like (°C)\", ROUND(pm25_aqi_at_spike::numeric, 1) AS \"PM2.5 at Spike\", ROUND(pm25_aqi_2h_after::numeric, 1) AS \"PM2.5 +2h\", ROUND(pm25_aqi_delta_2h::numeric, 1) AS \"AQI Δ 2h\", ROUND(nuclear_pct::numeric, 1) AS \"Nuclear %\", ROUND(fossil_pct::numeric, 1) AS \"Fossil %\" FROM marts.mart_demand_spike_events WHERE $__timeFilter(spike_hour) ORDER BY spike_hour DESC",
