      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "pipeline-db" },
          "format": "table",
          "rawSql": "SELECT f.name, f.operator, f.facility_type AS type, f.lat, f.lon, f.region_id, f.capacity_mw_est, ROUND(g.fossil_pct::numeric, 1) AS fossil_pct, ROUND(g.clean_pct::numeric, 1) AS clean_pct, ROUND((d.demand_avg_mw / 1000.0)::numeric, 1) AS demand_gw FROM marts.datacenter_facilities f LEFT JOIN (SELECT region_id, AVG(fossil_pct) AS fossil_pct, AVG(clean_pct) AS clean_pct FROM grid_generation_raw WHERE time >= NOW() - INTERVAL '26 hours' GROUP BY region_id) g ON f.region_id = g.region_id LEFT JOIN (SELECT region_id, AVG(demand_avg_mw) AS demand_avg_mw FROM grid_demand_hourly WHERE bucket >= NOW() - INTERVAL '3 hours' GROUP BY region_id) d ON f.region_id = d.region_id ORDER BY f.capacity_mw_est DESC",
          "refId": "A"
        }
      ],
      "title": "Data Center Locations — hover for live grid state",
      "type": "geomap"
